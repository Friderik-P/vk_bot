# --- VK API ---
VK_API_TOKEN=
VK_GROUP_ID=

# --- GigaChat ---
GIGACHAT_AUTH_KEY=

# --- Администраторы ---
ADMIN_IDS=

# --- Сервер ---
SERVER_NAME=KotServer

# --- База данных и логи ---
DB_FILE=bot.db
LOG_DIR=logs

# --- Ограничения и таймауты ---
MAX_HISTORY_PER_USER=500
MAX_MESSAGE_LENGTH=2000
SPAM_BAN_MINUTES=5
ADULT_BAN_MINUTES=5
ADULT_VIOLATION_LIMIT=3
ADULT_VIOLATION_WINDOW_MINUTES=30
GIGACHAT_TIMEOUT_SECONDS=15

# --- Опциональные настройки (имеют дефолты) ---
MAX_HISTORY=50
RATE_LIMIT_COUNT=20
RATE_LIMIT_MINUTES=5